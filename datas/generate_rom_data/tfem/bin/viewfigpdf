#!/bin/sh

# define PDFVIEWER or change evince to your favorite pdf viewer
pdfviewer=${PDFVIEWER:-evince}

type $pdfviewer >/dev/null 2>&1
if [ $? -eq 1 ]; then
  echo
  echo $pdfviewer: not found
  echo
  echo Set environment variable PDFVIEWER to a valid pdf viewer
  echo
  exit
fi

sys=`uname -s | cut -c 1-5`

if [ "$sys" = Darwi -a "$pdfviewer" = open ] ; then
  # Start new instance of preview and wait
  pdfviewer="open -nW"
fi

echo Merging fig files
mergefig2pdf $*
if [ $? -eq 1 ]; then exit 1; fi
echo Viewing with $pdfviewer
$pdfviewer merge.pdf
echo Deleting file merge.pdf
rm merge.pdf
