#!/bin/sh

if [ $# -eq 0 ]
then
  echo "Usage: fig2 language [figfiles(s)]"
  echo "where language should be one of:"
  fig2dev -L xxx 2>&1 | tail -n 1
  exit
else
   language=$1
fi
shift

if [ $# -eq 0 ]
then
     files=*.fig
else
     files=$*
fi

for file in $files
do
    fig2dev -L $language $file `basename $file .fig`.$language
done
