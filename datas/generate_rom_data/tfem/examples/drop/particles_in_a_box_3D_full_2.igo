// Make a mesh consisting of a box with particles, all defined by
// a mesh consisting of
//   eight points
//   six surfaces for the box
//   nobj surfaces for particles
// NOTE: the mesh has to be merged before including this file.
//
// The full box, including the particles, is meshed.
// The space between the particles and the box is physical volume 1
// The space inside the particles is physical volume 2
//
// The input parameters are:
//
//   nobj = the number of particles
//
// NOTE: the parameters have to be defined before including this file.
//
// The mesh consists of eight (Physical) Points and 6+nobj Physical surfaces

// Create domain vertices

For i In {1:8}
  Physical Point(i) = i;
EndFor

// Create domain sides

For i In {1:6}
  Physical Surface(i) = i;
EndFor

// Create outer boundary

surf_loop[0] = newsl;
Surface Loop(surf_loop[0]) = { 1, 2, 3, 4, 5, 6 };

// Make nobj particles

For t In {1:nobj}

  surf_loop[t] = newsl;
 
  Surface Loop(surf_loop[t]) = {t+6};
 
  Physical Surface(t+6) = {t+6};

EndFor

// Create volume mesh (with holes)
 
Volume(1) = {surf_loop[]};
 
Physical Volume(1) = {1};

For t In {1:nobj}

  Volume(t+1) = {surf_loop[t]};

EndFor
 
Physical Volume(2) = {2:nobj+1};


// vim: set filetype=gmsh :  //
