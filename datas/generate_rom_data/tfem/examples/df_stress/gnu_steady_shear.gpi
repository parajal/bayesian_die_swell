set log
set format y "%h"
plot "steady.out" us 1:3 w l title "tau_{xy}"
pause -1
plot "steady.out" us 1:($3/$1) w l title "eta=tau_{xy}/x", [10:] 10/x
pause -1
plot "steady.out" us 1:($2-$6) w l title "tau_{xx}-tau_{yy}"
pause -1
plot "steady.out" us 1:(($2-$6)/$1**2) w l title "Psi_1=(tau_{xx}-tau_{yy})/x^2"
pause -1
plot "steady.out" us 1:(($2-$6)/$3) w l title "S=(tau_{xx}-tau_{yy})/tau_{xy}"
pause -1
