set log
plot "steady5.out" us 1:($3) w l title "$\tau_{xy}$"
pause -1
plot "steady5.out" us 1:($3/$1) w l title "$\eta=\tau_{xy}/x$"
pause -1
plot "steady5.out" us 1:($5) w l title "$\tau_e$"
pause -1
plot "steady5.out" us 1:(($2-$4)/$3) w l title "$S=(\tau_{xx}-\tau_{yy})/\tau_{xy}$"
pause -1
