set log
plot "steady1.out" us 1:(($2-$5)) w l title "$\tau_{xx}-\tau_{yy}$"
replot "steady1.out" us 1:($10) w l title "regime"
pause -1
plot "steady1.out" us 1:(($2-$5)/$1) w l title "$\eta_E=(\tau_{xx}-\tau_{yy})/x$"
pause -1
