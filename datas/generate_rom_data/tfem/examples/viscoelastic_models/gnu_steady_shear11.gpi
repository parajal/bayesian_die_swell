set log
plot "steady11.out" us 1:($3) w l title "$\tau_{xy}$"
pause -1
plot "steady11.out" us 1:($3/$1) w l title "$\eta=\tau_{xy}/x$", 1000/x
pause -1
plot "steady11.out" us 1:($8) w l title "$\tau_e$"
pause -1
plot "steady11.out" us 1:(($2-$5)/$3) w l title "$S=(\tau_{xx}-\tau_{yy})/\tau_{xy}$"
pause -1
