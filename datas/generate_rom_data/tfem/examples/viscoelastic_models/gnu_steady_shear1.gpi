#set terminal pdf color 
#set output 'steady_shear1.pdf'

#set terminal epslatex standalone color solid \
#    header "\\usepackage{amsmath,amssymb}" 12
# set the name of the .tex output file
#set output 'steady_shear1.tex'

set log
plot "steady1.out" us 1:($3) w l title "$\tau_{xy}$"
replot "steady1.out" us 1:($10) w l title "regime"
pause -1
plot "steady1.out" us 1:($3/$1) w l title "$\eta=\tau_{xy}/x$"
pause -1
plot "steady1.out" us 1:($8) w l title "$\tau_e$"
pause -1
unset log y
plot "steady1.out" us 1:($9) w l title "$trtau/3$"
pause -1
plot "steady1.out" us 1:($10) w l title "regime"
pause -1
plot "steady1.out" us 1:(($2-$5)/$3) w l title "$S=(\tau_{xx}-\tau_{yy})/\tau_{xy}$"
pause -1
#plot "steady1.out" us 1:(($2-$5)/$1**2) w l title "$\Psi_1=(\tau_{xx}-\tau_{yy})/x^2$"
#pause -1
#plot "steady1.out" us 1:(($2-$5)/$3) w l title "$S=(\tau_{xx}-\tau_{yy})/\tau_{xy}$"
#pause -1
