#set output "plots.eps"
#set term postscript enhanced eps color solid 20
c1 = 0.0
c2 = 1.0
set xlabel "theta"
set ylabel "pressure"
#set nokey
set xrange [-pi:pi]
plot "sample_p_out_xf17.out" us (atan2($2-c2,$1-c1)):4 w l
replot "sample_p_in_xf17.out" us (atan2($2-c2,$1-c1)):4 w l
pause -1

set xlabel "theta"
set ylabel "vx"
#set nokey
set xrange [-pi:pi]
plot "sample_v_out_xf17.out" us (atan2($2-c2,$1-c1)):4 w l
replot "sample_v_in_xf17.out" us (atan2($2-c2,$1-c1)):4 w l
pause -1

set xlabel "theta"
set ylabel "vy"
#set nokey
set xrange [-pi:pi]
plot "sample_v_out_xf17.out" us (atan2($2-c2,$1-c1)):5 w l
replot "sample_v_in_xf17.out" us (atan2($2-c2,$1-c1)):5 w l
pause -1

set xlabel "theta"
set ylabel "vz"
#set nokey
set xrange [-pi:pi]
plot "sample_v_out_xf17.out" us (atan2($2-c2,$1-c1)):6 w l
replot "sample_v_in_xf17.out" us (atan2($2-c2,$1-c1)):6 w l
pause -1

set xlabel "theta"
set ylabel "dudy"
#set nokey
set xrange [-pi:pi]
plot "sample_dudy_out_xf17.out" us (atan2($2-c2,$1-c1)):4 w l
replot "sample_dudy_in_xf17.out" us (atan2($2-c2,$1-c1)):4 w l
pause -1

