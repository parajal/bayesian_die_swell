#set output "vprofile.eps"
#set term postscript enhanced eps color solid 20
set xlabel "y"
set ylabel "velocity"
#set nokey
plot "vprofile_xf4.out" us 2:3 w l 
pause -1
set xlabel "theta"
set ylabel "pressure"
#set nokey
set xrange [-pi:pi]
plot "sample_p_outside_xf4.out" us (atan2($2-1,$1)):3 w l 
replot "sample_p_inside_xf4.out" us (atan2($2-1,$1)):3 w l 
pause -1
set xlabel "theta"
set ylabel "vorticity"
#set nokey
set xrange [-pi:pi]
plot "sample_vort_outside_xf4.out" us (atan2($2-1,$1)):3 w l 
replot "sample_vort_inside_xf4.out" us (atan2($2-1,$1)):3 w l 
pause -1
set xlabel "theta"
set ylabel "vx on cylinder"
#set key
set xrange [-pi:pi]
plot "sample_v_outside_xf4.out" us (atan2($2-1,$1)):3 w l 
replot "sample_v_inside_xf4.out" us (atan2($2-1,$1)):3 w l 
pause -1
set xlabel "theta"
set ylabel "vy on cylinder"
#set key
set xrange [-pi:pi]
plot "sample_v_outside_xf4.out" us (atan2($2-1,$1)):4 w l 
replot "sample_v_inside_xf4.out" us (atan2($2-1,$1)):4 w l 
pause -1
