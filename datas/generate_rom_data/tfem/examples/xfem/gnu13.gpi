#set output "vprofile.eps"
#set term postscript enhanced eps color solid 20
set xlabel "y"
set ylabel "velocity"
#set nokey
plot "vprofile_xf.out" us 2:3 w l 
pause -1
set xlabel "x"
set ylabel "pressure"
#set nokey
#set xrange [-pi:pi]
plot "sample_p_xf.out" us 1:3 w l 
pause -1
set xlabel "x"
set ylabel "vorticity"
#set nokey
#set xrange [-pi:pi]
plot "sample_vort_xf.out" us 1:3 w l 
pause -1
set xlabel "x"
set ylabel "vx and vy on cylinder"
#set key
#set xrange [-pi:pi]
plot "sample_v_xf.out" us 1:3 w l 
replot "sample_v_xf.out" us 1:4 w l 
pause -1
