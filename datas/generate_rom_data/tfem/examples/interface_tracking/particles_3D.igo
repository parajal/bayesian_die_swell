// Make a mesh consisting of nobj spherical particles.
// The space within the particles is meshed.
//
// The input parameters are:
//
// nobj = the number of spheres
// xp(i,:), yp(i,:), zp(i,:) = the coordinates of the center of the sphere i
// rp(i) = the radius of the sphere i
// dx_part = the characteristic line element size on the sphere surface
//
// NB: a single physical volume is generated

// Sphere

Function MakeSphere 

  p1 = newp; Point(p1) = {x,    y,   z,   dx_part} ;
  p2 = newp; Point(p2) = {x+r,  y,   z,   dx_part} ;
  p3 = newp; Point(p3) = {x,    y+r, z,   dx_part} ;
  p4 = newp; Point(p4) = {x,    y,   z+r, dx_part} ;
  p5 = newp; Point(p5) = {x-r,  y,   z,   dx_part} ;
  p6 = newp; Point(p6) = {x,    y-r, z,   dx_part} ;
  p7 = newp; Point(p7) = {x,    y,   z-r, dx_part} ;

  c1 = newl; Circle(c1) = {p2, p1, p7};
  c2 = newl; Circle(c2) = {p7, p1, p5};
  c3 = newl; Circle(c3) = {p5, p1, p4};
  c4 = newl; Circle(c4) = {p4, p1, p2};
  c5 = newl; Circle(c5) = {p2, p1, p3};
  c6 = newl; Circle(c6) = {p3, p1, p5};
  c7 = newl; Circle(c7) = {p5, p1, p6};
  c8 = newl; Circle(c8) = {p6, p1, p2};
  c9 = newl; Circle(c9) = {p7, p1, p3};
  c10 = newl; Circle(c10) = {p3, p1, p4};
  c11 = newl; Circle(c11) = {p4, p1, p6};
  c12 = newl; Circle(c12) = {p6, p1, p7};

  // Spherical surface

  lin1 = newll; Line Loop(lin1) = {c5, c10, c4};    Ruled Surface(news) = {lin1};
  lin2 = newll; Line Loop(lin2) = {c9, -c5, c1};    Ruled Surface(news) = {lin2};
  lin3 = newll; Line Loop(lin3) = {c12, -c8, -c1};  Ruled Surface(news) = {lin3};
  lin4 = newll; Line Loop(lin4) = {c8, -c4, c11};   Ruled Surface(news) = {lin4};
  lin5 = newll; Line Loop(lin5) = {-c10, c6, c3};   Ruled Surface(news) = {lin5};
  lin6 = newll; Line Loop(lin6) = {-c11, -c3, c7};  Ruled Surface(news) = {lin6};
  lin7 = newll; Line Loop(lin7) = {-c2, -c7, -c12}; Ruled Surface(news) = {lin7};
  lin8 = newll; Line Loop(lin8) = {-c6, -c9, c2};   Ruled Surface(news) = {lin8};

  surf_loop[t] = newsl;

  Surface Loop(surf_loop[t]) = {lin8+1, lin5+1, lin1+1, lin2+1, lin3+1, lin7+1, lin6+1, lin4+1};

  Physical Surface(t) = {lin8+1, lin5+1, lin1+1, lin2+1, lin3+1, lin7+1, lin6+1, lin4+1};

  thehole = newreg ; 
  Volume(thehole) = surf_loop[t];

  index[t] = thehole;

Return


// Make nobj spheres

For t In {1:nobj}

  x = xp[t];
  y = yp[t];
  z = zp[t];
  r = rp[t]; 

  Call MakeSphere;

EndFor

Physical Volume(1) = index[];

// vim: set filetype=gmsh :  //
