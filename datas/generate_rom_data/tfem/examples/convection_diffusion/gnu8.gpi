#set output "plots.eps"
#set term postscript enhanced eps color solid 20
set xlabel "theta"
set ylabel "scalar"
#set nokey
set xrange [-pi:pi]
plot "sample_c_out_cd8.out" us (atan2($2-0.5,$1-0.5)):3 w l
replot "sample_c_in_cd8.out" us (atan2($2-0.5,$1-0.5)):3 w l
pause -1

set xlabel "theta"
set ylabel "gradc_x"
#set nokey
set xrange [-pi:pi]
plot "sample_gc_out_cd8.out" us (atan2($2-0.5,$1-0.5)):3 w l
replot "sample_gc_in_cd8.out" us (atan2($2-0.5,$1-0.5)):3 w l
pause -1

set xlabel "theta"
set ylabel "gradc_y"
#set nokey
set xrange [-pi:pi]
plot "sample_gc_out_cd8.out" us (atan2($2-0.5,$1-0.5)):4 w l
replot "sample_gc_in_cd8.out" us (atan2($2-0.5,$1-0.5)):4 w l
pause -1

