// create a simple square mesh with triangular elements

Point(1) = {   ox,    oy, 0, dx};
Point(2) = {ox+lx,    oy, 0, dx};
Point(3) = {ox+lx, oy+ly, 0, dx};
Point(4) = {   ox, oy+ly, 0, dx};

Line(1) = {1,2} ;
Line(2) = {2,3} ;
Line(3) = {3,4} ;
Line(4) = {4,1} ;

Line Loop(5) = {1,2,3,4} ;

Plane Surface(1) = {5} ;

