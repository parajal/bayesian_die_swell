set log
set xlabel "N"
plot [:100] "data" us 1:3 w lp title "mem amg", \
     "data" us 1:7 w lp title "CPU amg", \
     "data" us 1:8 w lp title "mem ma57", \
     "data" us 1:9 w lp title "CPU ma57", \
     1.7*x**5/10000 title "N^5", 0.4*x**3/1000 title "N^3", \
     x**5/100000 title "N^5", 1.2*x**3/100 title "N^3"
pause -1
